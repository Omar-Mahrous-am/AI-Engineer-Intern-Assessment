# Application
APP_NAME=Weather Backend
APP_ENV=development
DEBUG=false

# Database – replace with your PostgreSQL credentials
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/weather_db

# CORS – comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# HTTP client
HTTP_TIMEOUT_SECONDS=10

# Logging
LOG_LEVEL=INFO
